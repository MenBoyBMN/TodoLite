{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TodoLite",
  "version": "3.0.0",
  "identifier": "com.todolite.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TodoLite",
        "width": 460,
        "height": 540,
        "minWidth": 440,
        "minHeight": 400,
        "maxWidth": 550,
        "maxHeight": 750,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}